dplyr::rename(
id = barcode,
treatment = !!sym(covariate)  # Rename to 'treatment' to match later code
) %>%
mutate(sample_id_clean = gsub("\\-", ".", id)) %>% # clean id to match counts data
select(-id) %>%
filter(treatment %in% c("Yes","No")) %>% # Filter down to the two covariate groups of interest
as.data.frame()
rownames(metadata) <- metadata$sample_id_clean
# Filter and align expression counts matrix to match the filtered down metadata samples that have our groups of interest
counts_matrix <- counts_matrix[, rownames(metadata), drop = FALSE] # keep only columns that exist in our clean metadata in the same order
# check to make sure previous steps matched the data order or throw error
stopifnot(identical(rownames(metadata), colnames(counts_matrix)))
# set treatment group as a factor with two groups
metadata$treatment <- factor(
trimws(as.character(metadata$treatment)),
levels = c("Yes", "No")
)
# create a container that has all of the data needed for the differential expression analysis
dds <- DESeqDataSetFromMatrix(
countData = counts_matrix,
colData = metadata,
design = ~ treatment # set the design we want (mapping outcome (counts) vs. treatment variable that says if a patient has prior treatment or not)
)
dds <- DESeq(dds) # run the actual differential expression analysis statistical test to generate  values and fold changes
res <- results(dds, contrast = c("treatment", "Yes", "No")) # pull out the results, set the numerator to Yes and denominator to No, this means if you see a positive (upregulation) fold change then prior treatment led to higher expression and vice versa with a downregulation (negative fold change)
results_df <- as.data.frame(res)
results_df$gene_name <- rownames(results_df) # add rownames
# 4. Filter and Prep Data for Volcano Plot
volcano_data <- results_df %>%
filter(!is.na(padj), !is.na(log2FoldChange)) # remove results that were null
png("volcano_plot.png", width = 7, height = 8, units = "in", res = 300) # set output for latex png
# 5. Generate Enhanced Volcano Plot
EnhancedVolcano(
volcano_data,
lab = volcano_data$gene_name,
x = "log2FoldChange",
y = "padj",  # Using adjusted p-values for graph
# Significance thresholds
pCutoff = 0.05,
FCcutoff = 1.0,
# Labels and formatting
title = "Differential Gene Expression",
subtitle = "No Prior Treatment vs Prior Treatment",
xlab = bquote(~Log[2] ~ "Expression Value Change"),
ylab = bquote(~-Log[10] ~ "Adjusted P-value"), # Explicitly labeling p value as adjusted
# Formatting
pointSize = 2.0,
labSize = 4.0,
# Formatting to prevent overlapping text
drawConnectors = TRUE,
widthConnectors = 0.5,
colConnectors = 'black',
max.overlaps = 20
)
dev.off() # output
