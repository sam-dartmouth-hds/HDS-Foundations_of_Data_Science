# Add the Wilcoxon p-value
geom_text(
aes(
x = 1.5,
y = p_y_position,
label = p_label
),
inherit.aes = FALSE,
color = "red",
fontface = "bold"
) +
# Add mean and standard deviation
geom_text(
aes(
x = 1.5,
y = summary_y_position,
label = summary_label
),
inherit.aes = FALSE,
size = 3.5
) +
# Add title and axis labels
labs(
title = paste(
continuous_name,
"by",
categorical_name
),
x = categorical_name,
y = continuous_name,
fill = categorical_name
) +
# Use a clean theme
theme_minimal(base_size = 8) +
# Format the plot
theme(
plot.title = element_text(
hjust = 0.5,
face = "bold",
size = 10
),
axis.title = element_text(
face = "bold"
),
panel.grid.minor = element_blank()
)
# Return the completed plot
return(box_plot)
}
box_plot <- box_plot_function(merged_data, "Creatinine", "Sex", "Creatinine Level", "Sex")
box_plot
box_plot
n <- 100
# Create an empty list to store the 5 datasets
blood_cell_data <- list()
# Loop 5 times
for (i in 1:5) {
random_data <- data.frame(
Participant_ID = paste("pt", 1:n, sep = "_"),  # Generate Subject IDs
Sex = sample(c("Male", "Female"), n, replace = TRUE),  # Random sex values
Age = pmax(18, pmin(85, round(rnorm(n, mean = 50, sd = 10)))),  # Random ages between 18 and 90
white_blood_cell = runif(n, min = 3.4, max = 9.6)  # Random systolic blood pressure values
) %>%
group_by(Sex) %>% # Group by the variable
# Execute the specific sampling pattern depending on the group the participant falls into
mutate(
red_blood_cell = if (cur_group()$Sex == "Male") {
runif(n(), min = 4.35, max = 5.65)
} else {
runif(n(), min = 3.92, max = 5.13)
}
)
blood_cell_data[[i]] <- random_data
}
# write scatter plots
scatter_plots_blood_cells <- lapply(
blood_cell_data,
function(data) {
ggplot(
data,
aes(
x = red_blood_cell,
y = white_blood_cell,
color = Sex
)
) +
geom_point(
alpha = 0.5
) +
labs(
title = "Red Blood Cell vs White Blood Cell Count",
x = "Red Blood Cell Count cells/L (trillion)",
y = "White Blood Cell Count cells/L (billion)",
color = "Sex"
) +
theme_minimal(base_size = 8) +
theme(
plot.title = element_text(
hjust = 0.5,
face = "bold",
size = 8
),
axis.title = element_text(
face = "bold"
),
panel.grid.minor = element_blank()
)
}
)
scatter_plots_blood_cells
do.call(
ggarrange,
c(scatter_plots, ncol = 2, nrow = 3)
)
?ggarrange
