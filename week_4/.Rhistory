## Read in libraries
library(tidyverse)   # ggplot2, dplyr, readr, ...
set.seed(2025)       # reproducible "random" data
my_fun <- function(con_var){
my_dfs <- list()
n = 200
for (i in 1:20){
Sex <- sample(c("Male", "Female"), n, replace = TRUE)
Age <- pmax(18, pmin(85, round(rnorm(n, mean = 50, sd = 10))))
Platelet_Count <- round(runif(n, 1.35, 3.71),2)
# Create a dataframe with these data
dat_df <- data.frame(Sex, Age, Platelet_Count)
# Store in list of data frames
my_dfs[[i]] <- dat_df
# Create plot
p <- ggplot(dat_df, aes(x = .data[[con_var]])) +
geom_histogram(bins = 15, fill = "skyblue")
png(paste0("../figures/", con_var, "-", i, ".png"),
width = 1500,
height = 1000,
res = 300)
print(p)
dev.off()
}
var_summaries <- lapply(my_dfs, function(df) summary(df[[con_var]]))
return(var_summaries)
}
my_fun("Age")
